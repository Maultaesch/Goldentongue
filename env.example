# GoldenTongue launch settings. Copy to launch/.env and fill in. NEVER commit launch/.env or share it.
# `scripts/launch_website.sh` reads this file.

# ---- Supabase (supabase.com -> your project) ----
SUPABASE_PROJECT_REF=abcdefghijklmnop            # the id in https://<id>.supabase.co
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_ANON_KEY=                               # Project Settings -> API -> anon / publishable key (public by design)
DATABASE_URL=                                    # Project Settings -> Database -> Connection string (URI), with your DB password
SUPABASE_ACCESS_TOKEN=                           # optional: supabase.com/dashboard/account/tokens, lets the script set the Auth URLs

# ---- AI service (platform.openai.com) ----
OPENAI_API_KEY=                                  # sk-... (create a key just for GoldenTongue; set a monthly spend limit in OpenAI)
COACH_MODEL=gpt-4o-mini                          # model used by the Supabase functions (the website uses AI_MODEL in wrangler.toml)
FREE_DAILY_LIMIT=5                               # accounts without a membership (only matters if REQUIRE_PREMIUM is false)
MEMBER_DAILY_LIMIT=300                           # fair-use cap per paying member and day (admins are unlimited)

# ---- Website (Cloudflare Pages) ----
PAGES_PROJECT=goldentongue-members               # project name; the address becomes https://<name>.pages.dev
WEB_ORIGIN=https://goldentongue-members.pages.dev   # the final website address (custom domain later)
SUPPORT_EMAIL=                                   # shown on the public account deletion page
PRIVACY_URL=                                     # public page with your privacy policy
TERMS_URL=                                       # public page with your terms of use

# ---- Admin (you) ----
ADMIN_EMAIL=                                     # sign up with this address on the site, then scripts/make_admin.sh grants full access

# ---- Optional: bot protection (Cloudflare Turnstile) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Optional: payments (Stripe). Without these the site works for admins only. ----
STRIPE_SECRET_KEY=                               # sk_test_... first, sk_live_... at launch
STRIPE_WEBHOOK_SECRET=                           # whsec_... of the endpoint https://<ref>.supabase.co/functions/v1/stripe-webhook
STRIPE_PRICE_MONTHLY=                            # price_...
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=

# ---- Optional: mobile app purchases (RevenueCat) ----
REVENUECAT_WEBHOOK_AUTH=
